{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:4b",
  "default_agent": "build",
  "formatter": true,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" }
  ],
  "providers": {
    "ollama": {
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B (local)"
        }
      }
    }
  },
  "commands": {
    "verifier-html": {
      "description": "Vérifie la structure et les balises du fichier HTML",
      "template": "Vérifie le fichier index.html : balises HTML non fermées, attributs cassés, liens et chemins d'images invalides, accessibilité de base (alt, contraste, labels de formulaire). Liste les problèmes puis corrige-les."
    }
  }
}
